# Copy to .env and fill in. `make docker-secrets` writes a .env with generated
# secrets if you would rather not pick them yourself.
#
# docker-compose.yml declares the four secrets below with `${VAR:?}`, so the
# stack refuses to start when one is missing rather than substituting a default.
# That is deliberate: a default admin credential published in a repository is
# not a credential.

# ---- secrets: no defaults anywhere, required by docker-compose ----
# Gates the policy and rule CRUD APIs, which can raise any tenant's limits to
# anything. Unset in development leaves them open; unset under
# NODE_ENV=production makes them return 503 rather than accept anonymous writes.
CONTROL_PLANE_API_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ---- server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Interface the container's port 3000 is published on. 0.0.0.0 exposes the
# gateway to the network; every other service in the stack stays on loopback.
GATEWAY_BIND=127.0.0.1
# Comma-separated allowed origins, or unset for none.
CORS_ORIGIN=

# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# ---- postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rate_limiter
POSTGRES_USER=postgres
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT=30000

# ---- generic rate limiter defaults ----
DEFAULT_RATE_LIMIT=1000
DEFAULT_WINDOW_SECONDS=60
DEFAULT_ALGORITHM=token_bucket

# ---- LLM admission ----
# How long a settled reservation's idempotency marker is kept, in seconds. Long
# enough to cover a client's retry window; every marker carries its own TTL, so
# this bounds the ledger rather than letting it grow without limit.
COMMIT_IDEMPOTENCY_TTL=300

# ---- behaviour when Redis is unreachable: fail_open | fail_closed ----
RATE_LIMIT_FAILURE_MODE=fail_open
ADMISSION_FAILURE_MODE=fail_closed

# ---- observability ----
# Metrics are served on the main port at /metrics. There is no separate port.
ENABLE_METRICS=true
LOG_LEVEL=info
LOG_FORMAT=json
# Requests at or above this many milliseconds get an individual warn line.
# Per-request info logging is deliberately off: measured at 1,500 cycles/s it
# cost a fifth of a core and pushed p99 from 55ms to 6.9s.
SLOW_REQUEST_LOG_MS=250
