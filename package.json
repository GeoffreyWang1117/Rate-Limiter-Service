{
  "name": "llm-admission-gateway",
  "version": "3.0.0",
  "description": "Token-aware admission control for LLM inference: reserve/commit budgeting with lease reclamation, SLO-aware shedding, and distributed rate limiting on Redis",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"bench/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test",
    "db:migrate": "node dist/scripts/migrate.js",
    "stack:up": "./scripts/devstack.sh up",
    "stack:down": "./scripts/devstack.sh down",
    "stack:status": "./scripts/devstack.sh status",
    "serve": "./scripts/serve.sh start",
    "serve:stop": "./scripts/serve.sh stop",
    "bench:admission": "tsx bench/bench-admission.ts",
    "bench:reservation": "tsx bench/bench-reservation.ts",
    "bench:sweep": "./bench/sweep.sh",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "bench:reservation:sweep": "bash bench/sweep-reservation.sh"
  },
  "keywords": [
    "llm",
    "admission-control",
    "rate-limiting",
    "inference-gateway",
    "token-budget",
    "backpressure",
    "redis",
    "distributed-systems",
    "slo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
